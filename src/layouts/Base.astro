---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'CodeBook';
const { title, description = "Haruband's TechBlog — Linux kernel, eBPF, Kubernetes, Arrow/Datafusion" } = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : SITE;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Posts' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Code<span>Book</span></a>
        <nav class="nav">
          {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Inhyeok Kim</span>
        <nav>
          <a href="https://github.com/haruband/">GitHub</a>
          <a href="https://www.linkedin.com/in/inhyeok-kim-7620a0b0/">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
